rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero insecure defaults - deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User data isolation: each user can only read/write their own interactions and profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /interactions/{interactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
